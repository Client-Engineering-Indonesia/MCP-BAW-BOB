# IBM CP4BA Configuration
# Replace these values with your actual IBM CP4BA instance details
CP4BA_BASE_URL=https://your-cp4ba-instance.com
CP4BA_USERNAME=your-username
CP4BA_PASSWORD=your-password

# Token Configuration
# Token lifetime in seconds (default: 7200 = 2 hours)
TOKEN_LIFETIME=7200

# Server Configuration
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# HTTP request timeout in seconds
REQUEST_TIMEOUT=30

# Maximum number of retry attempts for failed requests
MAX_RETRIES=3

# SSL certificate verification (set to true for production)
VERIFY_SSL=false

# Rate Limiting
# Enable rate limiting to prevent API abuse
RATE_LIMIT_ENABLED=true

# Maximum number of API calls allowed per period
RATE_LIMIT_CALLS=100

# Rate limit period in seconds
RATE_LIMIT_PERIOD=60